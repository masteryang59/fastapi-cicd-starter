# Copy to .env for local runs. Every setting is optional.

# local | compose | ci | staging | production (shown on the landing page and in /version)
ENVIRONMENT=local

# SQLite by default. Any postgres:// or postgresql:// URL works too (the psycopg 3 driver is used).
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://app:app@localhost:5432/shortlinks

# Enables GET /api/links and DELETE /api/links/{slug} (header: X-API-Key). Unset = disabled.
ADMIN_API_KEY=

# Public origin for short URLs, e.g. https://sho.rt. Unset = taken from each request.
PUBLIC_BASE_URL=

# Server (python -m app.serve). The Docker image sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8080
WEB_CONCURRENCY=1
RUN_MIGRATIONS=true

LOG_LEVEL=INFO
# json (one object per line, for Cloud Logging / CloudWatch) or text
LOG_FORMAT=text
ROLLBACK_CHANGES=enabled
SERIALIZE_DATA=enabled
ROLLBACK_CHANGES=enabled